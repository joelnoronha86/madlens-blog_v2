---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const localPages = await getCollection('pages');
const pagesDataJson = JSON.stringify(
  localPages.map((p) => ({
    name: p.id,
    slug: p.data.slug || p.id.replace(/\.json$/, ''),
    data: p.data,
  }))
);
---

<BaseLayout
  title="Edit Landing Page | Easyblocks Visual Studio"
  description="Edit custom visual landing pages with Easyblocks."
>
  <div class="py-6 bg-parchment-base min-h-screen flex flex-col">
    <div class="max-w-[1600px] w-full mx-auto px-4 sm:px-6 flex-grow flex flex-col">
      
      <!-- Top Studio Toolbar -->
      <div class="bg-parchment-light border border-parchment-border p-4 rounded-sm shadow-sm mb-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        
        <!-- Left: Back & Title inputs -->
        <div class="flex flex-wrap items-center gap-3 flex-grow max-w-2xl">
          <a
            href="/admin/landing-pages"
            class="font-mono text-xs text-sage-botanical hover:text-madder-red transition-colors flex items-center gap-1"
          >
            &larr; Pages
          </a>
          <span class="text-parchment-border">|</span>
          <input
            id="page-title-input"
            type="text"
            class="flex-grow px-3 py-1.5 rounded border border-parchment-border bg-parchment-base font-heading text-lg text-indigo-deep font-semibold focus:outline-none focus:border-indigo-deep"
          />
          <div class="flex items-center font-mono text-xs text-sage-botanical">
            <span>/pages/</span>
            <input
              id="page-slug-input"
              type="text"
              readonly
              class="w-36 px-2 py-1.5 rounded border border-parchment-border bg-parchment-deep text-ink-muted font-mono text-xs cursor-not-allowed"
            />
          </div>
        </div>

        <!-- Center: Status / CI Skip Indicator -->
        <div class="flex items-center gap-2">
          <span id="save-status-badge" class="px-2.5 py-1 rounded text-[11px] font-mono bg-emerald-50 text-emerald-800 border border-emerald-300 font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>AUTOSAVED (0ms LOCAL)</span>
          </span>
          <span id="ci-skip-badge" class="hidden sm:inline-block px-2 py-0.5 rounded text-[10px] font-mono bg-parchment-deep text-sage-botanical border border-parchment-border" title="Draft commits include [skip ci] so Cloudflare Pages will not trigger a rebuild until you click Publish.">
            CI: SKIP ON DRAFT
          </span>
        </div>

        <!-- Right: Action Buttons -->
        <div class="flex items-center gap-2">
          <!-- View Live Preview -->
          <button
            id="view-preview-btn"
            type="button"
            class="px-3 py-2 rounded border border-indigo-deep/30 bg-parchment-base hover:bg-parchment-deep text-indigo-deep font-mono text-xs uppercase tracking-wider flex items-center gap-1.5 shadow-sm"
          >
            <svg class="w-4 h-4 text-sage-botanical" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <span>Preview</span>
          </button>

          <!-- Save Draft (No Cloudflare Rebuild) -->
          <button
            id="save-draft-btn"
            type="button"
            class="px-4 py-2 rounded border border-madder-red/40 bg-madder-soft hover:bg-madder-red hover:text-parchment-light text-madder-red font-mono text-xs uppercase tracking-wider font-bold transition-all shadow-sm flex items-center gap-1.5"
            title="Saves to Git with [skip ci] - Cloudflare will NOT rebuild."
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            <span>Save Draft</span>
          </button>

          <!-- Publish to Production (Triggers Cloudflare Rebuild) -->
          <button
            id="publish-btn"
            type="button"
            class="px-5 py-2 rounded bg-indigo-deep hover:bg-emerald-800 text-parchment-light font-mono text-xs uppercase tracking-widest font-bold transition-all shadow-sm flex items-center gap-1.5"
            title="Publishes to Git without [skip ci] - Cloudflare Pages will rebuild and deploy!"
          >
            <svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Publish to Production</span>
          </button>
        </div>

      </div>

      <!-- Toast Feedback Message -->
      <div id="toast-msg" class="hidden mb-4 p-3 rounded font-mono text-xs transition-all shadow-sm"></div>

      <!-- Main Studio 3-Column Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 flex-grow items-start">
        
        <!-- Left: Palette -->
        <div class="lg:col-span-3 bg-parchment-light border border-parchment-border p-4 rounded-sm shadow-sm space-y-4 sticky top-28 max-h-[85vh] overflow-y-auto">
          <div class="border-b border-parchment-border pb-2.5 flex items-center justify-between">
            <span class="font-mono text-xs uppercase tracking-widest text-sage-botanical font-bold">
              COMPONENT PALETTE
            </span>
            <span class="font-mono text-[10px] text-ink-muted">EASYBLOCKS</span>
          </div>

          <div class="space-y-2">
            <button
              type="button"
              class="add-block-btn w-full text-left p-3 rounded border border-parchment-border bg-parchment-base hover:border-indigo-deep hover:bg-parchment-light transition-all flex items-center gap-3 group"
              data-block-type="HeroSectionBlock"
            >
              <div class="w-8 h-8 rounded bg-indigo-deep/10 text-indigo-deep flex items-center justify-center font-bold font-mono group-hover:bg-indigo-deep group-hover:text-parchment-light transition-colors">
                H
              </div>
              <div>
                <div class="font-mono text-xs font-bold text-indigo-deep">Hero Banner</div>
                <div class="font-body text-[11px] text-sage-botanical">Title, subtitle, CTA & flat-lay</div>
              </div>
            </button>

            <button
              type="button"
              class="add-block-btn w-full text-left p-3 rounded border border-parchment-border bg-parchment-base hover:border-indigo-deep hover:bg-parchment-light transition-all flex items-center gap-3 group"
              data-block-type="EditorialTwoColBlock"
            >
              <div class="w-8 h-8 rounded bg-madder-red/10 text-madder-red flex items-center justify-center font-bold font-mono group-hover:bg-madder-red group-hover:text-parchment-light transition-colors">
                2C
              </div>
              <div>
                <div class="font-mono text-xs font-bold text-indigo-deep">Editorial 2-Column</div>
                <div class="font-body text-[11px] text-sage-botanical">Drop cap essay & studio image</div>
              </div>
            </button>

            <button
              type="button"
              class="add-block-btn w-full text-left p-3 rounded border border-parchment-border bg-parchment-base hover:border-indigo-deep hover:bg-parchment-light transition-all flex items-center gap-3 group"
              data-block-type="SwatchAtlasBlock"
            >
              <div class="w-8 h-8 rounded bg-weld-ochre/15 text-weld-ochre flex items-center justify-center font-bold font-mono group-hover:bg-weld-ochre group-hover:text-parchment-light transition-colors">
                SW
              </div>
              <div>
                <div class="font-mono text-xs font-bold text-indigo-deep">Swatch Grid</div>
                <div class="font-body text-[11px] text-sage-botanical">Pinked edge swatches & binomials</div>
              </div>
            </button>

            <button
              type="button"
              class="add-block-btn w-full text-left p-3 rounded border border-parchment-border bg-parchment-base hover:border-indigo-deep hover:bg-parchment-light transition-all flex items-center gap-3 group"
              data-block-type="SpecimenShowcaseBlock"
            >
              <div class="w-8 h-8 rounded bg-sage-botanical/15 text-sage-botanical flex items-center justify-center font-bold font-mono group-hover:bg-sage-botanical group-hover:text-parchment-light transition-colors">
                SP
              </div>
              <div>
                <div class="font-mono text-xs font-bold text-indigo-deep">Specimen Dossier</div>
                <div class="font-body text-[11px] text-sage-botanical">Coordinates & chromophore</div>
              </div>
            </button>

            <button
              type="button"
              class="add-block-btn w-full text-left p-3 rounded border border-parchment-border bg-parchment-base hover:border-indigo-deep hover:bg-parchment-light transition-all flex items-center gap-3 group"
              data-block-type="QuoteCalloutBlock"
            >
              <div class="w-8 h-8 rounded bg-indigo-deep/10 text-indigo-deep flex items-center justify-center font-bold font-mono group-hover:bg-indigo-deep group-hover:text-parchment-light transition-colors">
                &ldquo;&rdquo;
              </div>
              <div>
                <div class="font-mono text-xs font-bold text-indigo-deep">Quote Callout</div>
                <div class="font-body text-[11px] text-sage-botanical">Research citation & notes</div>
              </div>
            </button>

            <button
              type="button"
              class="add-block-btn w-full text-left p-3 rounded border border-parchment-border bg-parchment-base hover:border-indigo-deep hover:bg-parchment-light transition-all flex items-center gap-3 group"
              data-block-type="GalleryTriptychBlock"
            >
              <div class="w-8 h-8 rounded bg-parchment-deep text-indigo-deep flex items-center justify-center font-bold font-mono group-hover:bg-indigo-deep group-hover:text-parchment-light transition-colors">
                GL
              </div>
              <div>
                <div class="font-mono text-xs font-bold text-indigo-deep">Field Gallery</div>
                <div class="font-body text-[11px] text-sage-botanical">3-card photo expedition triptych</div>
              </div>
            </button>

            <button
              type="button"
              class="add-block-btn w-full text-left p-3 rounded border border-parchment-border bg-parchment-base hover:border-indigo-deep hover:bg-parchment-light transition-all flex items-center gap-3 group"
              data-block-type="NewsletterDispatchBlock"
            >
              <div class="w-8 h-8 rounded bg-madder-soft text-madder-red flex items-center justify-center font-bold font-mono group-hover:bg-madder-red group-hover:text-parchment-light transition-colors">
                NL
              </div>
              <div>
                <div class="font-mono text-xs font-bold text-indigo-deep">Newsletter CTA</div>
                <div class="font-body text-[11px] text-sage-botanical">Postal dispatch email form</div>
              </div>
            </button>

            <button
              type="button"
              class="add-block-btn w-full text-left p-3 rounded border border-parchment-border bg-parchment-base hover:border-indigo-deep hover:bg-parchment-light transition-all flex items-center gap-3 group"
              data-block-type="RawMarkdownBlock"
            >
              <div class="w-8 h-8 rounded bg-parchment-deep text-ink-muted flex items-center justify-center font-bold font-mono group-hover:bg-ink-charcoal group-hover:text-parchment-light transition-colors">
                MD
              </div>
              <div>
                <div class="font-mono text-xs font-bold text-indigo-deep">Custom Markdown</div>
                <div class="font-body text-[11px] text-sage-botanical">Freeform markdown or HTML section</div>
              </div>
            </button>
          </div>
        </div>

        <!-- Center: Visual Canvas -->
        <div class="lg:col-span-6 space-y-4">
          <div class="bg-parchment-light border border-parchment-border p-3 rounded-sm shadow-sm flex items-center justify-between font-mono text-xs text-sage-botanical">
            <span class="font-bold uppercase tracking-wider text-indigo-deep">
              CANVAS: <span id="block-count-badge">0 BLOCKS</span>
            </span>
            <div class="flex items-center gap-2">
              <span class="text-[11px]">Click a block to edit its properties &rarr;</span>
            </div>
          </div>

          <div id="easyblocks-canvas" class="space-y-4"></div>
        </div>

        <!-- Right: Inspector -->
        <div class="lg:col-span-3 bg-parchment-light border border-parchment-border p-4 rounded-sm shadow-sm space-y-4 sticky top-28 max-h-[85vh] overflow-y-auto">
          <div class="border-b border-parchment-border pb-2.5 flex items-center justify-between">
            <span class="font-mono text-xs uppercase tracking-widest text-sage-botanical font-bold">
              BLOCK PROPERTIES
            </span>
            <span id="selected-block-type" class="font-mono text-[10px] text-madder-red font-bold"></span>
          </div>

          <div id="inspector-content">
            <p class="font-body text-xs text-indigo-deep/70 py-8 text-center italic">
              Select any block in the canvas to inspect and edit its properties.
            </p>
          </div>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>

<script define:vars={{ pagesDataJson }}>
  // @ts-ignore
  window.__LOCAL_PAGES__ = JSON.parse(pagesDataJson);
</script>

<script>
  import { getGitHubConfig, commitLandingPageToGitHub, base64ToUtf8 } from '../../../utils/github';

  interface EasyblocksBlock {
    id: string;
    type: string;
    props: Record<string, any>;
  }

  let blocks: EasyblocksBlock[] = [];
  let selectedBlockId: string | null = null;
  let currentSlug = '';
  let existingSha: string | undefined = undefined;

  const localPages: any[] = (window as any).__LOCAL_PAGES__ || [];

  async function loadPage() {
    const params = new URLSearchParams(window.location.search);
    const slug = params.get('slug') || params.get('file');

    if (!slug) {
      alert('No landing page specified.');
      window.location.href = '/admin/landing-pages';
      return;
    }

    currentSlug = slug.replace(/\.json$/, '');
    (document.getElementById('page-slug-input') as HTMLInputElement).value = currentSlug;

    // 1. Try local collection
    const match = localPages.find((p) => p.slug === currentSlug || p.name === `${currentSlug}.json`);
    if (match && match.data) {
      populatePage(match.data);
    }

    // 2. Also check GitHub if connected
    const config = getGitHubConfig();
    if (config && config.token && config.owner && config.repo) {
      try {
        const cleanPath = (config.pagesPath || 'src/content/pages').replace(/^\/+|\/+$/g, '');
        const url = `https://api.github.com/repos/${config.owner}/${config.repo}/contents/${cleanPath}/${currentSlug}.json?ref=${config.branch}`;
        const res = await fetch(url, {
          headers: {
            Authorization: `Bearer ${config.token}`,
            Accept: 'application/vnd.github.v3+json',
          },
        });

        if (res.ok) {
          const gitData = await res.json();
          existingSha = gitData.sha;
          const decoded = base64ToUtf8(gitData.content);
          const parsed = JSON.parse(decoded);
          populatePage(parsed);
        }
      } catch (err) {
        console.warn('GitHub fetch failed, relying on local data:', err);
      }
    }
  }

  function populatePage(data: any) {
    if (data.title) (document.getElementById('page-title-input') as HTMLInputElement).value = data.title;
    if (data.blocks && Array.isArray(data.blocks)) {
      blocks = data.blocks;
      if (blocks.length > 0 && !selectedBlockId) {
        selectedBlockId = blocks[0].id;
      }
    }
    renderCanvas();
    renderInspector();
  }

  function autoSaveLocal() {
    const title = (document.getElementById('page-title-input') as HTMLInputElement)?.value || 'Untitled Page';
    const payload = {
      title,
      slug: currentSlug,
      draft: true,
      updatedAt: new Date().toISOString(),
      blocks,
    };
    localStorage.setItem(`easyblocks_landing_${currentSlug}`, JSON.stringify(payload));

    const badge = document.getElementById('save-status-badge');
    if (badge) {
      badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span><span>AUTOSAVED (0ms LOCAL)</span>`;
      badge.className = 'px-2.5 py-1 rounded text-[11px] font-mono bg-emerald-50 text-emerald-800 border border-emerald-300 font-bold flex items-center gap-1.5';
    }
  }

  function renderCanvas() {
    const canvas = document.getElementById('easyblocks-canvas');
    const countBadge = document.getElementById('block-count-badge');
    if (countBadge) countBadge.textContent = `${blocks.length} BLOCKS`;
    if (!canvas) return;

    canvas.innerHTML = '';

    blocks.forEach((block, idx) => {
      const isSelected = block.id === selectedBlockId;
      const blockEl = document.createElement('div');
      blockEl.className = `border rounded-sm transition-all duration-200 cursor-pointer overflow-hidden relative group ${
        isSelected
          ? 'border-indigo-deep ring-2 ring-indigo-deep/30 shadow-md bg-parchment-light'
          : 'border-parchment-border hover:border-indigo-deep/40 bg-parchment-light/80 shadow-sm'
      }`;

      const toolbar = `
        <div class="bg-parchment-deep/70 px-4 py-2 border-b border-parchment-border/70 flex items-center justify-between font-mono text-xs">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded bg-indigo-deep/10 text-indigo-deep flex items-center justify-center font-bold text-[10px]">
              ${idx + 1}
            </span>
            <span class="font-bold text-indigo-deep uppercase tracking-wider">${block.type}</span>
          </div>

          <div class="flex items-center gap-1">
            <button type="button" class="move-up-btn p-1 rounded hover:bg-parchment-base text-sage-botanical hover:text-indigo-deep" data-idx="${idx}" title="Move Up">
              &uarr;
            </button>
            <button type="button" class="move-down-btn p-1 rounded hover:bg-parchment-base text-sage-botanical hover:text-indigo-deep" data-idx="${idx}" title="Move Down">
              &darr;
            </button>
            <button type="button" class="duplicate-btn p-1 rounded hover:bg-parchment-base text-sage-botanical hover:text-indigo-deep" data-idx="${idx}" title="Duplicate">
              &#10064;
            </button>
            <button type="button" class="delete-btn p-1 rounded hover:bg-madder-soft text-sage-botanical hover:text-madder-red" data-idx="${idx}" title="Delete">
              &#10005;
            </button>
          </div>
        </div>
      `;

      let previewHtml = '';
      if (block.type === 'HeroSectionBlock') {
        previewHtml = `
          <div class="p-6 bg-parchment-base/40">
            <div class="font-mono text-[10px] text-sage-botanical uppercase tracking-wider">${block.props.tagline || ''}</div>
            <h3 class="font-heading text-2xl text-indigo-deep font-semibold mt-1">${block.props.title || 'Hero Title'}</h3>
            <p class="font-heading italic text-sm text-sage-botanical mt-1">${block.props.subtitle || ''}</p>
          </div>
        `;
      } else if (block.type === 'EditorialTwoColBlock') {
        previewHtml = `
          <div class="p-6">
            <h3 class="font-heading text-xl text-indigo-deep">${block.props.heading || 'Editorial Heading'}</h3>
            <p class="font-body text-xs text-indigo-deep/80 mt-1 line-clamp-2">${block.props.col1 || ''}</p>
          </div>
        `;
      } else if (block.type === 'SwatchAtlasBlock') {
        previewHtml = `
          <div class="p-6 bg-parchment-deep/20 text-center">
            <h4 class="font-heading text-lg text-indigo-deep">${block.props.heading || 'Swatch Grid'}</h4>
            <div class="flex items-center justify-center gap-3 mt-3">
              ${(block.props.swatches || []).map((s: any) => `
                <div class="w-8 h-8 rounded-sm swatch-pinked shadow-sm" style="background-color: ${s.color};" title="${s.name}"></div>
              `).join('')}
            </div>
          </div>
        `;
      } else if (block.type === 'QuoteCalloutBlock') {
        previewHtml = `
          <div class="p-6 bg-parchment-deep/40 text-center italic font-heading text-base text-indigo-deep">
            &ldquo;${block.props.quote || 'Quote text'}&rdquo;
            <div class="font-mono text-[10px] uppercase tracking-wider text-sage-botanical mt-2 not-italic font-bold">
              ${block.props.author || ''}
            </div>
          </div>
        `;
      } else {
        previewHtml = `<div class="p-4 text-xs font-mono text-sage-botanical">${block.type} &bull; ${JSON.stringify(block.props).slice(0, 80)}...</div>`;
      }

      blockEl.innerHTML = toolbar + previewHtml;

      blockEl.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('button')) return;
        selectedBlockId = block.id;
        renderCanvas();
        renderInspector();
      });

      canvas.appendChild(blockEl);
    });

    // Wire actions
    document.querySelectorAll('.move-up-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((btn as HTMLElement).getAttribute('data-idx') || '0', 10);
        if (idx > 0) {
          const temp = blocks[idx];
          blocks[idx] = blocks[idx - 1];
          blocks[idx - 1] = temp;
          autoSaveLocal();
          renderCanvas();
        }
      });
    });

    document.querySelectorAll('.move-down-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((btn as HTMLElement).getAttribute('data-idx') || '0', 10);
        if (idx < blocks.length - 1) {
          const temp = blocks[idx];
          blocks[idx] = blocks[idx + 1];
          blocks[idx + 1] = temp;
          autoSaveLocal();
          renderCanvas();
        }
      });
    });

    document.querySelectorAll('.duplicate-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((btn as HTMLElement).getAttribute('data-idx') || '0', 10);
        const cloned: EasyblocksBlock = {
          id: `blk-${Date.now()}`,
          type: blocks[idx].type,
          props: JSON.parse(JSON.stringify(blocks[idx].props)),
        };
        blocks.splice(idx + 1, 0, cloned);
        selectedBlockId = cloned.id;
        autoSaveLocal();
        renderCanvas();
        renderInspector();
      });
    });

    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt((btn as HTMLElement).getAttribute('data-idx') || '0', 10);
        blocks.splice(idx, 1);
        if (selectedBlockId === blocks[idx]?.id) {
          selectedBlockId = blocks[0]?.id || null;
        }
        autoSaveLocal();
        renderCanvas();
        renderInspector();
      });
    });
  }

  function renderInspector() {
    const inspector = document.getElementById('inspector-content');
    const typeBadge = document.getElementById('selected-block-type');
    if (!inspector) return;

    const block = blocks.find((b) => b.id === selectedBlockId);
    if (!block) {
      if (typeBadge) typeBadge.textContent = '';
      inspector.innerHTML = `
        <p class="font-body text-xs text-indigo-deep/70 py-8 text-center italic">
          Select any block in the canvas to inspect and edit its properties.
        </p>
      `;
      return;
    }

    if (typeBadge) typeBadge.textContent = block.type;

    let fieldsHtml = '<div class="space-y-4 font-mono text-xs">';

    Object.keys(block.props).forEach((key) => {
      const val = block.props[key];
      const label = key.replace(/([A-Z])/g, ' $1').toUpperCase();

      if (typeof val === 'string' && val.length > 50) {
        fieldsHtml += `
          <div>
            <label class="block text-sage-botanical uppercase mb-1 font-bold text-[11px]">${label}</label>
            <textarea
              data-prop="${key}"
              rows="3"
              class="inspector-input w-full px-3 py-1.5 rounded border border-parchment-border bg-parchment-base text-indigo-deep font-body text-xs leading-relaxed focus:outline-none focus:border-indigo-deep"
            >${val}</textarea>
          </div>
        `;
      } else if (typeof val === 'string') {
        fieldsHtml += `
          <div>
            <label class="block text-sage-botanical uppercase mb-1 font-bold text-[11px]">${label}</label>
            <input
              type="text"
              data-prop="${key}"
              value="${val.replace(/"/g, '&quot;')}"
              class="inspector-input w-full px-3 py-1.5 rounded border border-parchment-border bg-parchment-base text-indigo-deep focus:outline-none focus:border-indigo-deep"
            />
          </div>
        `;
      }
    });

    fieldsHtml += '</div>';
    inspector.innerHTML = fieldsHtml;

    inspector.querySelectorAll('.inspector-input').forEach((input) => {
      input.addEventListener('input', (e) => {
        const propName = (input as HTMLElement).getAttribute('data-prop');
        if (propName && block) {
          block.props[propName] = (e.target as HTMLInputElement).value;
          autoSaveLocal();
          renderCanvas();
        }
      });
    });
  }

  // Add block buttons
  document.querySelectorAll('.add-block-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-block-type') || 'HeroSectionBlock';
      const newBlock: EasyblocksBlock = {
        id: `blk-${Date.now()}`,
        type,
        props: {
          title: 'New Section',
          subtitle: 'Section Description',
        },
      };
      blocks.push(newBlock);
      selectedBlockId = newBlock.id;
      autoSaveLocal();
      renderCanvas();
      renderInspector();
    });
  });

  function showToast(msg: string, type: 'success' | 'error' | 'info') {
    const toast = document.getElementById('toast-msg');
    if (!toast) return;

    toast.textContent = msg;
    toast.className = `p-3 rounded font-mono text-xs shadow-sm block ${
      type === 'success' ? 'bg-emerald-50 text-emerald-800 border border-emerald-300' :
      type === 'error' ? 'bg-red-50 text-red-800 border border-red-300' :
      'bg-indigo-soft text-indigo-deep border border-indigo-deep/30'
    }`;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.getElementById('view-preview-btn')?.addEventListener('click', () => {
    window.open(`/admin/preview/pages/${currentSlug}`, '_blank');
  });

  // Save / Publish
  async function handleSave(isDraft: boolean) {
    const title = (document.getElementById('page-title-input') as HTMLInputElement)?.value.trim() || 'Untitled Page';
    const saveDraftBtn = document.getElementById('save-draft-btn');
    const publishBtn = document.getElementById('publish-btn');
    const badge = document.getElementById('save-status-badge');

    if (isDraft && saveDraftBtn) saveDraftBtn.textContent = 'Saving Draft to Git...';
    if (!isDraft && publishBtn) publishBtn.textContent = 'Publishing to Cloudflare...';

    const landingDoc = {
      title,
      slug: currentSlug,
      description: title,
      draft: isDraft,
      updatedAt: new Date().toISOString(),
      blocks,
    };

    localStorage.setItem(`easyblocks_landing_${currentSlug}`, JSON.stringify(landingDoc));

    const config = getGitHubConfig();

    if (config && config.token && config.owner && config.repo) {
      try {
        const result = await commitLandingPageToGitHub(config, currentSlug, landingDoc, existingSha);
        existingSha = result.commit?.sha || existingSha;

        if (badge) {
          if (isDraft) {
            badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500"></span><span>DRAFT SAVED (CI SKIPPED)</span>`;
            badge.className = 'px-2.5 py-1 rounded text-[11px] font-mono bg-amber-50 text-amber-800 border border-amber-300 font-bold flex items-center gap-1.5';
          } else {
            badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>PUBLISHED (CLOUDFLARE BUILDING)</span>`;
            badge.className = 'px-2.5 py-1 rounded text-[11px] font-mono bg-emerald-50 text-emerald-800 border border-emerald-300 font-bold flex items-center gap-1.5';
          }
        }

        const msg = isDraft
          ? `Draft committed with [skip ci]! Cloudflare Pages build skipped.`
          : `Published to GitHub! Cloudflare Pages rebuild triggered. Live in 30-60 seconds!`;

        showToast(msg, 'success');
      } catch (err: any) {
        showToast(`GitHub commit error: ${err.message}`, 'error');
      } finally {
        if (saveDraftBtn) saveDraftBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg><span>Save Draft</span>`;
        if (publishBtn) publishBtn.innerHTML = `<svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Publish to Production</span>`;
      }
    } else {
      showToast('Page saved locally! Connect GitHub in the dashboard to push to your live site.', 'info');
      if (saveDraftBtn) saveDraftBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg><span>Save Draft</span>`;
      if (publishBtn) publishBtn.innerHTML = `<svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg><span>Publish to Production</span>`;
    }
  }

  document.getElementById('save-draft-btn')?.addEventListener('click', () => handleSave(true));
  document.getElementById('publish-btn')?.addEventListener('click', () => handleSave(false));

  loadPage();
</script>
