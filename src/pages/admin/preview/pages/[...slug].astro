---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EasyblocksRenderer from '../../../../components/easyblocks/EasyblocksRenderer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages');

  return pages.map((page) => ({
    params: { slug: page.data.slug || page.id.replace(/\.json$/, '') },
    props: { page },
  }));
}

const { page } = Astro.props;
const { data } = page;
---

<BaseLayout
  title={`[Preview] ${data.title} | Geographies of Natural Dyes`}
  description={data.description}
>
  <!-- Draft Preview Engine Top Banner -->
  <div class="bg-amber-100 border-b border-amber-300 px-4 py-3 sticky top-20 sm:top-24 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 font-mono text-xs">
      <div class="flex items-center gap-2 text-amber-900">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
        <strong class="uppercase">EASYBLOCKS PREVIEW ENGINE:</strong>
        <span>Viewing <code class="bg-amber-200/60 px-1 rounded">{page.id}</code> ({data.draft ? 'Status: Draft' : 'Status: Published'})</span>
      </div>
      <div class="flex items-center gap-3">
        <a
          href={`/admin/landing-pages/edit?slug=${encodeURIComponent(data.slug)}`}
          class="px-3 py-1 rounded bg-indigo-deep text-parchment-light uppercase tracking-wider font-bold hover:bg-madder-red transition-colors"
        >
          Edit in Easyblocks &rarr;
        </a>
        <a
          href="/admin/landing-pages"
          class="text-indigo-deep hover:underline"
        >
          Close Preview
        </a>
      </div>
    </div>
  </div>

  <div class="easyblocks-landing-page">
    <EasyblocksRenderer blocks={data.blocks} />
  </div>
</BaseLayout>
