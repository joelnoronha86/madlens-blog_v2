---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FieldSpecimenCard from '../../../components/FieldSpecimenCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
}).format(data.pubDate);
---

<BaseLayout
  title={`[Preview] ${data.title} | Geographies of Natural Dyes`}
  description={data.excerpt}
  image={data.coverImage}
>
  <!-- Top Draft Preview Banner -->
  <div class="bg-amber-100 border-b border-amber-300 px-4 py-3 sticky top-20 sm:top-24 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 font-mono text-xs">
      <div class="flex items-center gap-2 text-amber-900">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
        <strong class="uppercase">DRAFT PREVIEW ENGINE:</strong>
        <span>Viewing <code class="bg-amber-200/60 px-1 rounded">{post.id}</code> ({data.draft ? 'Status: Draft' : 'Status: Published'})</span>
      </div>
      <div class="flex items-center gap-3">
        <a
          href={`/admin/edit?file=${encodeURIComponent(post.id)}`}
          class="px-3 py-1 rounded bg-indigo-deep text-parchment-light uppercase tracking-wider font-bold hover:bg-madder-red transition-colors"
        >
          Edit in Tiptap Studio &rarr;
        </a>
        <a
          href="/admin"
          class="text-indigo-deep hover:underline"
        >
          Close Preview
        </a>
      </div>
    </div>
  </div>

  <article class="py-12 bg-parchment-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Article Header & Metadata -->
      <header class="max-w-4xl mb-10">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-sage-botanical mb-4">
          <span class="font-bold text-madder-red">{data.issue}</span>
          <span>&bull;</span>
          <span>DISPATCH #{post.id.slice(0, 4).toUpperCase()}</span>
          {data.draft && (
            <span class="px-2 py-0.5 rounded bg-madder-red text-parchment-light font-bold text-[10px]">
              DRAFT
            </span>
          )}
        </div>

        <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-indigo-deep leading-[1.1] font-semibold tracking-tight">
          {data.title}
        </h1>

        {data.subtitle && (
          <p class="font-heading italic text-xl sm:text-2xl text-sage-botanical mt-3">
            {data.subtitle}
          </p>
        )}

        <div class="mt-6 pt-4 border-t border-parchment-border flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-sage-botanical uppercase tracking-wider">
          <div>
            WORDS BY <strong class="text-indigo-deep">{data.author}</strong> | {formattedDate}
          </div>
          <div class="flex items-center gap-2">
            <span class="text-ink-muted">TAGS:</span>
            {data.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded bg-parchment-deep text-indigo-deep text-[11px]">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      </header>

      <!-- Main Two-Column Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Column: Content -->
        <div class="lg:col-span-8 space-y-8">
          
          {data.coverImage && (
            <figure class="border border-parchment-border p-2 bg-parchment-light rounded-sm shadow-sm">
              <img
                src={data.coverImage}
                alt={data.coverCaption || data.title}
                class="w-full h-auto object-cover rounded-sm max-h-[500px]"
              />
              {data.coverCaption && (
                <figcaption class="mt-3 font-mono text-xs text-sage-botanical text-center uppercase tracking-wider">
                  {data.coverCaption}
                </figcaption>
              )}
            </figure>
          )}

          <div class="prose prose-lg max-w-none text-indigo-deep font-body leading-relaxed drop-cap bg-parchment-light/60 p-6 sm:p-8 rounded-sm border border-parchment-border/70">
            <Content />
          </div>

        </div>

        <!-- Right Column: Scientific Specimen Box -->
        <div class="lg:col-span-4 sticky top-40 space-y-6">
          <FieldSpecimenCard
            specimen={data.specimen}
            swatches={data.swatches}
          />
        </div>

      </div>

    </div>
  </article>
</BaseLayout>
