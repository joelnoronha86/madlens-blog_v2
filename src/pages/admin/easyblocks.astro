            <div>
              <label class="block text-gray-500 text-[11px] mb-1">Subtitle / Body Text</label>
              <textarea id="prop-subtitle" rows="3" class="w-full p-2 border border-[#E5E7EB] rounded text-gray-800 text-xs leading-relaxed"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-gray-500 text-[11px] mb-1">Button 1 Text</label>
                <input id="prop-btn1-text" type="text" placeholder="Show now" class="w-full p-1.5 border border-[#E5E7EB] rounded text-xs" />
              </div>
              <div>
                <label class="block text-gray-500 text-[11px] mb-1">Button 1 Link</label>
                <input id="prop-btn1-link" type="text" placeholder="#content" class="w-full p-1.5 border border-[#E5E7EB] rounded text-xs" />
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-gray-500 text-[11px] mb-1">Button 2 Text</label>
                <input id="prop-btn2-text" type="text" placeholder="Learn more" class="w-full p-1.5 border border-[#E5E7EB] rounded text-xs" />
              </div>
              <div>
                <label class="block text-gray-500 text-[11px] mb-1">Button 2 Link</label>
                <input id="prop-btn2-link" type="text" placeholder="/about" class="w-full p-1.5 border border-[#E5E7EB] rounded text-xs" />
              </div>
            </div>
          </div>

        </div>
      </aside>

    </div>

    <!-- Add Section Modal (Opens when clicking the blue + handle) -->
    <div id="add-section-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-2xl max-w-lg w-full p-6 space-y-4">
        <div class="flex items-center justify-between border-b pb-3">
          <h3 class="font-bold text-sm text-gray-900">Add Section (Easyblocks Component)</h3>
          <button id="close-add-modal" type="button" class="text-gray-400 hover:text-black">&times;</button>
        </div>

        <div class="grid grid-cols-2 gap-3 text-xs">
          <button type="button" class="modal-add-btn text-left p-3 border rounded hover:border-blue-500 hover:bg-blue-50/30" data-type="HeroSectionBlock">
            <div class="font-bold text-gray-900">Hero / Banner Section</div>
            <div class="text-[11px] text-gray-500">Title, description, buttons, cover image</div>
          </button>

          <button type="button" class="modal-add-btn text-left p-3 border rounded hover:border-blue-500 hover:bg-blue-50/30" data-type="EditorialTwoColBlock">
            <div class="font-bold text-gray-900">Editorial 2-Column</div>
            <div class="text-[11px] text-gray-500">Drop cap essay & studio figure image</div>
          </button>

          <button type="button" class="modal-add-btn text-left p-3 border rounded hover:border-blue-500 hover:bg-blue-50/30" data-type="SwatchAtlasBlock">
            <div class="font-bold text-gray-900">Swatch Grid</div>
            <div class="text-[11px] text-gray-500">Fabric swatches with binomial taxonomy</div>
          </button>

          <button type="button" class="modal-add-btn text-left p-3 border rounded hover:border-blue-500 hover:bg-blue-50/30" data-type="SpecimenShowcaseBlock">
            <div class="font-bold text-gray-900">Specimen Dossier</div>
            <div class="text-[11px] text-gray-500">Coordinates, archive & chemistry</div>
          </button>

          <button type="button" class="modal-add-btn text-left p-3 border rounded hover:border-blue-500 hover:bg-blue-50/30" data-type="QuoteCalloutBlock">
            <div class="font-bold text-gray-900">Quote Callout</div>
            <div class="text-[11px] text-gray-500">Poetic research quotation & byline</div>
          </button>

          <button type="button" class="modal-add-btn text-left p-3 border rounded hover:border-blue-500 hover:bg-blue-50/30" data-type="GalleryTriptychBlock">
            <div class="font-bold text-gray-900">Photo Gallery Triptych</div>
            <div class="text-[11px] text-gray-500">3-card field photo expedition</div>
          </button>

          <button type="button" class="modal-add-btn text-left p-3 border rounded hover:border-blue-500 hover:bg-blue-50/30" data-type="NewsletterDispatchBlock">
            <div class="font-bold text-gray-900">Newsletter CTA</div>
            <div class="text-[11px] text-gray-500">Field note subscription form</div>
          </button>

          <button type="button" class="modal-add-btn text-left p-3 border rounded hover:border-blue-500 hover:bg-blue-50/30" data-type="RawMarkdownBlock">
            <div class="font-bold text-gray-900">Custom Markdown</div>
            <div class="text-[11px] text-gray-500">Freeform markdown or HTML</div>
          </button>
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast-pill" class="hidden fixed bottom-6 left-1/2 transform -translate-x-1/2 px-4 py-2 rounded-full shadow-lg font-mono text-xs z-50 text-white bg-black"></div>

    <script define:vars={{ pagesPayloadJson }}>
      window.__PAGES_DATABASE__ = JSON.parse(pagesPayloadJson);
    </script>

    <script>
      import { getGitHubConfig, commitLandingPageToGitHub } from '../../utils/github';

      interface EasyblocksBlock {
        id: string;
        type: string;
        props: Record<string, any>;
      }

      const pagesDatabase: any[] = (window as any).__PAGES_DATABASE__ || [];
      let currentPageSlug = 'home';
      let activeBlocks: EasyblocksBlock[] = [];
      let selectedBlockId: string | null = null;
      let editMode = true;
      let insertIndex = -1;

      // History stack for undo/redo
      let historyStack: string[] = [];
      let historyIndex = -1;

      function pushHistory() {
        const snapshot = JSON.stringify(activeBlocks);
        if (historyStack[historyIndex] !== snapshot) {
          historyStack = historyStack.slice(0, historyIndex + 1);
          historyStack.push(snapshot);
          historyIndex = historyStack.length - 1;
        }
      }

      // Load page data
      function loadPage(slug: string) {
        currentPageSlug = slug;
        const pageSelect = document.getElementById('page-select') as HTMLSelectElement | null;
        if (pageSelect) pageSelect.value = slug;

        // Check localStorage first for any draft autosaves
        const localCached = localStorage.getItem(`easyblocks_landing_${slug}`);
        if (localCached) {
          try {
            const parsed = JSON.parse(localCached);
            activeBlocks = parsed.blocks || [];
          } catch {
            activeBlocks = [];
          }
        } else {
          const match = pagesDatabase.find((p) => p.slug === slug);
          if (match && match.blocks) {
            activeBlocks = JSON.parse(JSON.stringify(match.blocks));
          } else {
            activeBlocks = [];
          }
        }

        if (activeBlocks.length > 0) {
          selectedBlockId = activeBlocks[0].id;
        } else {
          selectedBlockId = null;
        }

        historyStack = [JSON.stringify(activeBlocks)];
        historyIndex = 0;

        renderCanvas();
        populateInspector();
      }

      function autoSaveLocal() {
        const payload = {
          slug: currentPageSlug,
          draft: true,
          updatedAt: new Date().toISOString(),
          blocks: activeBlocks,
        };
        localStorage.setItem(`easyblocks_landing_${currentPageSlug}`, JSON.stringify(payload));
        pushHistory();
      }

      // Render the visual Canvas
      function renderCanvas() {
        const stack = document.getElementById('sections-stack');
        if (!stack) return;
        stack.innerHTML = '';

        activeBlocks.forEach((block, idx) => {
          const isSelected = block.id === selectedBlockId && editMode;
          const sectionEl = document.createElement('div');
          sectionEl.className = `relative transition-all duration-150 ${isSelected ? 'easyblocks-selected' : ''}`;
          sectionEl.setAttribute('data-block-id', block.id);

          // Top circle + handle if selected
          if (isSelected) {
            const plusTop = document.createElement('div');
            plusTop.className = 'plus-handle-top';
            plusTop.innerHTML = '+';
            plusTop.title = 'Add section above';
            plusTop.addEventListener('click', (e) => {
              e.stopPropagation();
              openAddModal(idx);
            });
            sectionEl.appendChild(plusTop);
          }

          // Render block interior matching the aesthetic
          const innerWrapper = document.createElement('div');
          const p = block.props;
          const isReverse = p.coverPosition === 'left';
          const coverPos = p.coverPosition || 'right';
          const hasCover = p.image && coverPos !== 'none';
          const coverW = p.coverWidth || '50%';
          const bgCol = p.fillEnable ? (p.fillColor || '#F4EFE6') : 'white';

          innerWrapper.style.marginTop = `${p.marginTop || 0}px`;
          innerWrapper.style.marginBottom = `${p.marginBottom || 64}px`;
          innerWrapper.style.paddingTop = `${p.paddingTop || 48}px`;
          innerWrapper.style.paddingBottom = `${p.paddingBottom || 48}px`;
          innerWrapper.style.backgroundColor = bgCol;
          innerWrapper.style.paddingLeft = p.marginLeftRight === 'none' ? '0' : '24px';
          innerWrapper.style.paddingRight = p.marginLeftRight === 'none' ? '0' : '24px';

          // Block specific markup
          if (block.type === 'HeroSectionBlock' || block.type === 'Banner Section') {
            const stackPos = p.stackPosition || 'center';
            const isCentered = stackPos.includes('center');
            const isRight = stackPos.includes('right');
            const textAlignClass = isRight ? 'text-right' : isCentered ? 'text-center' : 'text-left';
            const itemsAlignClass = isRight ? 'items-end' : isCentered ? 'items-center' : 'items-start';
            const justifyClass = isRight ? 'justify-end' : isCentered ? 'justify-center' : 'justify-start';
            const coverValign = p.coverVerticalAlign || 'stretch';

            innerWrapper.innerHTML = `
              <div class="${p.escape ? 'w-full px-4 sm:px-6' : 'max-w-7xl mx-auto px-4 sm:px-6'}">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-8 ${coverValign === 'stretch' ? 'items-stretch' : 'items-center'} ${isReverse ? 'flex-row-reverse' : ''}" style="gap: ${p.paddingInternal !== undefined ? p.paddingInternal : 24}px;">
                  <div class="${hasCover ? (coverW === '50%' ? 'md:col-span-6' : 'md:col-span-7') : 'md:col-span-12'} flex flex-col ${itemsAlignClass} ${textAlignClass} justify-center space-y-4 py-8 ${isReverse ? 'md:order-2' : 'md:order-1'}">
                    ${p.tagline ? `<div class="font-mono text-xs uppercase tracking-widest text-[#5B7065] font-bold">✦ ${p.tagline} ✦</div>` : ''}
                    <h1 class="text-4xl sm:text-5xl font-bold text-[#111827] leading-tight" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; letter-spacing: -0.02em;">
                      ${p.title || 'Get comfy'}
                    </h1>
                    <p class="text-sm sm:text-base text-gray-600 leading-relaxed max-w-md ${isCentered ? 'mx-auto' : ''}" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                      ${p.subtitle || 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do this is cool and gets even cooler incididunt ut labore.'}
                    </p>
                    <div class="pt-3 flex flex-wrap items-center gap-3 ${justifyClass}">
                      <a href="${p.ctaLink || '#'}" class="px-5 py-2.5 rounded-md bg-[#18181B] text-white font-medium text-xs shadow-sm hover:bg-black transition-colors">
                        ${p.ctaText || 'Show now'}
                      </a>
                      <a href="${p.secondaryCtaLink || '#'}" class="px-5 py-2.5 rounded-md bg-white border border-[#D4D4D8] text-[#18181B] font-medium text-xs shadow-sm hover:bg-gray-50 transition-colors">
                        ${p.secondaryCtaText || 'Learn more'}
                      </a>
                    </div>
                  </div>
                  ${hasCover ? `
                    <div class="${coverW === '50%' ? 'md:col-span-6' : 'md:col-span-5'} ${isReverse ? 'md:order-1' : 'md:order-2'} flex items-center">
                      <div class="relative w-full h-full min-h-[340px] overflow-hidden rounded-md border border-[#E5E7EB] shadow-xs">
                        <img src="${p.image || '/images/hero-field-notebook-flatlay.jpeg'}" alt="Cover" class="w-full h-full object-cover object-center" />
                      </div>
                    </div>
                  ` : ''}
                </div>
              </div>
            `;
          } else if (block.type === 'EditorialTwoColBlock') {
            innerWrapper.innerHTML = `
              <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <h2 class="font-heading text-3xl text-[#2C4251] mb-2" style="font-family: 'Cormorant Garamond', Georgia, serif;">${p.heading || 'Editorial'}</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 font-body text-sm leading-relaxed text-[#2C4251]/80" style="font-family: 'Lora', Georgia, serif;">
                  <p class="drop-cap">${p.col1 || ''}</p>
                  <p>${p.col2 || ''}</p>
                </div>
              </div>
            `;
          } else if (block.type === 'SwatchAtlasBlock') {
            innerWrapper.innerHTML = `
              <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
                <h3 class="font-heading text-2xl text-[#2C4251] mb-6" style="font-family: 'Cormorant Garamond', Georgia, serif;">${p.heading || 'Swatch Grid'}</h3>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                  ${(p.swatches || []).map((s: any) => `
                    <div class="p-3 bg-white border border-[#DCD3C1] rounded text-center">
                      <div class="w-16 h-16 mx-auto mb-2 rounded shadow-sm" style="background-color: ${s.color};"></div>
                      <div class="font-mono text-xs font-bold text-[#2C4251] uppercase">${s.name}</div>
                      <div class="font-heading italic text-xs text-[#5B7065]">${s.binomial || ''}</div>
                    </div>
                  `).join('')}
                </div>
              </div>
            `;
          } else if (block.type === 'QuoteCalloutBlock') {
            innerWrapper.innerHTML = `
              <div class="max-w-4xl mx-auto px-4 text-center py-6">
                <blockquote class="font-heading italic text-2xl text-[#2C4251] leading-relaxed" style="font-family: 'Cormorant Garamond', Georgia, serif;">
                  &ldquo;${p.quote || ''}&rdquo;
                </blockquote>
                <div class="font-mono text-xs uppercase font-bold text-[#5B7065] mt-3">${p.author || ''}</div>
              </div>
            `;
          } else if (block.type === 'NewsletterDispatchBlock') {
            innerWrapper.innerHTML = `
              <div class="max-w-2xl mx-auto px-4 text-center">
                <h3 class="font-heading text-2xl text-[#2C4251] mb-2" style="font-family: 'Cormorant Garamond', Georgia, serif;">${p.heading || 'Newsletter'}</h3>
                <p class="font-body text-xs text-[#2C4251]/80 mb-4" style="font-family: 'Lora', Georgia, serif;">${p.subheading || ''}</p>
                <div class="flex gap-2 max-w-sm mx-auto">
                  <input type="email" placeholder="researcher@fieldnotes.org" class="flex-grow p-2 border border-[#DCD3C1] rounded text-xs" />
                  <button class="px-4 py-2 bg-[#2C4251] text-white font-mono text-xs font-bold uppercase rounded">${p.buttonText || 'Subscribe'}</button>
                </div>
              </div>
            `;
          } else {
            innerWrapper.innerHTML = `<div class="p-6 text-xs font-mono text-gray-500">${block.type} &bull; ${JSON.stringify(p).slice(0, 100)}...</div>`;
          }

          sectionEl.appendChild(innerWrapper);

          // Bottom circle + handle if selected
          if (isSelected) {
            const plusBottom = document.createElement('div');
            plusBottom.className = 'plus-handle-bottom';
            plusBottom.innerHTML = '+';
            plusBottom.title = 'Add section below';
            plusBottom.addEventListener('click', (e) => {
              e.stopPropagation();
              openAddModal(idx + 1);
            });
            sectionEl.appendChild(plusBottom);
          }

          // Click to select block
          sectionEl.addEventListener('click', () => {
            if (!editMode) return;
            selectedBlockId = block.id;
            renderCanvas();
            populateInspector();
          });

          stack.appendChild(sectionEl);
        });
      }

      // Populate right Inspector sidebar matching screenshot
      function populateInspector() {
        const block = activeBlocks.find((b) => b.id === selectedBlockId);
        const compTitle = document.getElementById('insp-component-name');
        if (!block) {
          if (compTitle) compTitle.textContent = 'No Section Selected';
          return;
        }

        if (compTitle) {
          compTitle.textContent = block.type === 'HeroSectionBlock' ? 'Banner Section' : block.type;
        }

        const p = block.props;

        // Margins
        const mTop = document.getElementById('prop-margin-top') as HTMLSelectElement | null;
        const mBot = document.getElementById('prop-margin-bottom') as HTMLSelectElement | null;
        const mLr = document.getElementById('prop-margin-lr') as HTMLSelectElement | null;
        const mMax = document.getElementById('prop-max-width') as HTMLSelectElement | null;
        if (mTop) mTop.value = String(p.marginTop || 0);
        if (mBot) mBot.value = String(p.marginBottom !== undefined ? p.marginBottom : 64);
        if (mLr) mLr.value = p.marginLeftRight || 'standard';
        if (mMax) mMax.value = p.maxWidth || 'None';

        // Cover
        const cPos = document.getElementById('prop-cover-pos') as HTMLSelectElement | null;
        const cValign = document.getElementById('prop-cover-valign') as HTMLSelectElement | null;
        const cWidth = document.getElementById('prop-cover-width') as HTMLSelectElement | null;
        const cImg = document.getElementById('prop-image-url') as HTMLInputElement | null;
        if (cPos) cPos.value = p.coverPosition || 'right';
        if (cValign) cValign.value = p.coverVerticalAlign || 'stretch';
        if (cWidth) cWidth.value = p.coverWidth || '50%';
        if (cImg) cImg.value = p.image || '';

        // Padding
        const pTop = document.getElementById('prop-pad-top') as HTMLSelectElement | null;
        const pBot = document.getElementById('prop-pad-bottom') as HTMLSelectElement | null;
        const pInt = document.getElementById('prop-pad-internal') as HTMLSelectElement | null;
        if (pTop) pTop.value = String(p.paddingTop || 0);
        if (pBot) pBot.value = String(p.paddingBottom || 0);
        if (pInt) pInt.value = String(p.paddingInternal || 24);

        // Fill
        const fEnable = document.getElementById('prop-fill-enable') as HTMLInputElement | null;
        const fColor = document.getElementById('prop-fill-color') as HTMLInputElement | null;
        const fHex = document.getElementById('prop-fill-hex');
        const fPicker = document.getElementById('fill-color-picker');
        if (fEnable) {
          fEnable.checked = Boolean(p.fillEnable);
          if (fPicker) fPicker.classList.toggle('hidden', !p.fillEnable);
        }
        if (fColor && p.fillColor) {
          fColor.value = p.fillColor;
          if (fHex) fHex.textContent = p.fillColor;
        }

        // Text Content
        const hInput = document.getElementById('prop-heading') as HTMLInputElement | null;
        const sInput = document.getElementById('prop-subtitle') as HTMLTextAreaElement | null;
        const b1Text = document.getElementById('prop-btn1-text') as HTMLInputElement | null;
        const b1Link = document.getElementById('prop-btn1-link') as HTMLInputElement | null;
        const b2Text = document.getElementById('prop-btn2-text') as HTMLInputElement | null;
        const b2Link = document.getElementById('prop-btn2-link') as HTMLInputElement | null;

        if (hInput) hInput.value = p.title || p.heading || '';
        if (sInput) sInput.value = p.subtitle || p.subheading || p.col1 || '';
        if (b1Text) b1Text.value = p.ctaText || '';
        if (b1Link) b1Link.value = p.ctaLink || '';
        if (b2Text) b2Text.value = p.secondaryCtaText || '';
        if (b2Link) b2Link.value = p.secondaryCtaLink || '';

        // Escape toggle
        const escToggle = document.getElementById('prop-escape-toggle') as HTMLInputElement | null;
        if (escToggle) escToggle.checked = p.escape !== undefined ? Boolean(p.escape) : true;

        // Stack 3x3 matrix active position
        const currentPos = p.stackPosition || 'center';
        document.querySelectorAll('.stack-cell').forEach((c) => {
          const pos = c.getAttribute('data-pos');
          if (pos === currentPos) {
            c.classList.add('active');
            c.innerHTML = `
              <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="currentColor">
                <rect x="4" y="6" width="16" height="2" rx="1" />
                <rect x="4" y="11" width="16" height="2" rx="1" />
                <rect x="4" y="16" width="16" height="2" rx="1" />
              </svg>
            `;
          } else {
            c.classList.remove('active');
            c.innerHTML = '&bull;';
          }
        });
      }

      // Wire Inspector Inputs
      function attachInspectorListeners() {
        const updateProp = (key: string, val: any) => {
          const block = activeBlocks.find((b) => b.id === selectedBlockId);
          if (block) {
            block.props[key] = val;
            autoSaveLocal();
            renderCanvas();
          }
        };

        // 3x3 stack matrix click handlers
        document.querySelectorAll('.stack-cell').forEach((cell) => {
          cell.addEventListener('click', () => {
            const pos = cell.getAttribute('data-pos') || 'center';
            const block = activeBlocks.find((b) => b.id === selectedBlockId);
            if (block) {
              block.props.stackPosition = pos;
              autoSaveLocal();
              renderCanvas();
              populateInspector();
            }
          });
        });

        // Escape toggle
        document.getElementById('prop-escape-toggle')?.addEventListener('change', (e) => {
          updateProp('escape', (e.target as HTMLInputElement).checked);
        });

        // Collapse inspector
        document.getElementById('collapse-inspector-btn')?.addEventListener('click', () => {
          document.getElementById('inspector-body')?.classList.toggle('hidden');
        });

        // Component type dropdown toggle
        const typeBtn = document.getElementById('component-type-btn');
        const typeMenu = document.getElementById('component-type-dropdown');
        typeBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          typeMenu?.classList.toggle('hidden');
        });
        document.addEventListener('click', () => {
          typeMenu?.classList.add('hidden');
        });

        // Component type changer
        document.querySelectorAll('.type-opt').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const newType = btn.getAttribute('data-type');
            const block = activeBlocks.find((b) => b.id === selectedBlockId);
            if (block && newType) {
              block.type = newType;
              typeMenu?.classList.add('hidden');
              autoSaveLocal();
              renderCanvas();
              populateInspector();
            }
          });
        });

        document.getElementById('prop-margin-top')?.addEventListener('change', (e) => updateProp('marginTop', parseInt((e.target as HTMLSelectElement).value, 10)));
        document.getElementById('prop-margin-bottom')?.addEventListener('change', (e) => updateProp('marginBottom', parseInt((e.target as HTMLSelectElement).value, 10)));
        document.getElementById('prop-margin-lr')?.addEventListener('change', (e) => updateProp('marginLeftRight', (e.target as HTMLSelectElement).value));
        document.getElementById('prop-max-width')?.addEventListener('change', (e) => updateProp('maxWidth', (e.target as HTMLSelectElement).value));

        document.getElementById('prop-cover-pos')?.addEventListener('change', (e) => updateProp('coverPosition', (e.target as HTMLSelectElement).value));
        document.getElementById('prop-cover-valign')?.addEventListener('change', (e) => updateProp('coverVerticalAlign', (e.target as HTMLSelectElement).value));
        document.getElementById('prop-cover-width')?.addEventListener('change', (e) => updateProp('coverWidth', (e.target as HTMLSelectElement).value));

        document.getElementById('prop-image-url')?.addEventListener('input', (e) => updateProp('image', (e.target as HTMLInputElement).value));
        document.getElementById('prop-image-preset')?.addEventListener('change', (e) => {
          const val = (e.target as HTMLSelectElement).value;
          if (val) {
            (document.getElementById('prop-image-url') as HTMLInputElement).value = val;
            updateProp('image', val);
          }
        });

        document.getElementById('prop-pad-top')?.addEventListener('change', (e) => updateProp('paddingTop', parseInt((e.target as HTMLSelectElement).value, 10)));
        document.getElementById('prop-pad-bottom')?.addEventListener('change', (e) => updateProp('paddingBottom', parseInt((e.target as HTMLSelectElement).value, 10)));
        document.getElementById('prop-pad-internal')?.addEventListener('change', (e) => updateProp('paddingInternal', parseInt((e.target as HTMLSelectElement).value, 10)));

        document.getElementById('prop-fill-enable')?.addEventListener('change', (e) => {
          const checked = (e.target as HTMLInputElement).checked;
          document.getElementById('fill-color-picker')?.classList.toggle('hidden', !checked);
          updateProp('fillEnable', checked);
        });

        document.getElementById('prop-fill-color')?.addEventListener('input', (e) => {
          const val = (e.target as HTMLInputElement).value;
          const hexEl = document.getElementById('prop-fill-hex');
          if (hexEl) hexEl.textContent = val;
          updateProp('fillColor', val);
        });

        document.getElementById('prop-heading')?.addEventListener('input', (e) => {
          const val = (e.target as HTMLInputElement).value;
          const block = activeBlocks.find((b) => b.id === selectedBlockId);
          if (block) {
            block.props.title = val;
            block.props.heading = val;
            autoSaveLocal();
            renderCanvas();
          }
        });

        document.getElementById('prop-subtitle')?.addEventListener('input', (e) => {
          const val = (e.target as HTMLTextAreaElement).value;
          const block = activeBlocks.find((b) => b.id === selectedBlockId);
          if (block) {
            block.props.subtitle = val;
            block.props.subheading = val;
            autoSaveLocal();
            renderCanvas();
          }
        });

        document.getElementById('prop-btn1-text')?.addEventListener('input', (e) => updateProp('ctaText', (e.target as HTMLInputElement).value));
        document.getElementById('prop-btn1-link')?.addEventListener('input', (e) => updateProp('ctaLink', (e.target as HTMLInputElement).value));
        document.getElementById('prop-btn2-text')?.addEventListener('input', (e) => updateProp('secondaryCtaText', (e.target as HTMLInputElement).value));
        document.getElementById('prop-btn2-link')?.addEventListener('input', (e) => updateProp('secondaryCtaLink', (e.target as HTMLInputElement).value));
      }

      // Add Section Modal Handling
      function openAddModal(atIndex: number) {
        insertIndex = atIndex;
        document.getElementById('add-section-modal')?.classList.remove('hidden');
      }

      document.getElementById('close-add-modal')?.addEventListener('click', () => {
        document.getElementById('add-section-modal')?.classList.add('hidden');
      });

      document.querySelectorAll('.modal-add-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const type = btn.getAttribute('data-type') || 'HeroSectionBlock';
          let defaultProps: Record<string, any> = {};

          if (type === 'HeroSectionBlock') {
            defaultProps = {
              title: 'Get comfy with Botanical Dyes',
              subtitle: 'Blending molecular chemistry with the art of traditional textiles.',
              tagline: 'SPECIAL FIELD EDITION',
              image: '/images/hero-field-notebook-flatlay.jpeg',
              ctaText: 'Show now',
              ctaLink: '#content',
              secondaryCtaText: 'Learn more',
              secondaryCtaLink: '/about',
              coverPosition: 'right',
              coverWidth: '50%',
              marginTop: 0,
              marginBottom: 64,
              paddingInternal: 24,
              fillEnable: true,
              fillColor: '#F4EFE6',
            };
          } else if (type === 'EditorialTwoColBlock') {
            defaultProps = {
              heading: 'The Researcher & Artist',
              col1: 'Natural dyes represent one of humanity\'s earliest and most sophisticated organic biotechnologies.',
              col2: 'Through field research and studio practice, I investigate the intricate fermentation of indigo...',
              marginTop: 0,
              marginBottom: 48,
            };
          } else if (type === 'SwatchAtlasBlock') {
            defaultProps = {
              heading: 'The Living Color Atlas',
              swatches: [
                { name: 'Indigo Deep', binomial: 'Indigofera tinctoria', color: '#2C4251' },
                { name: 'Madder Red', binomial: 'Rubia tinctorum', color: '#943D36' },
                { name: 'Weld Ochre', binomial: 'Reseda luteola', color: '#C98E3A' },
                { name: 'Botanical Sage', binomial: 'Salvia officinalis', color: '#5B7065' },
              ],
            };
          } else if (type === 'QuoteCalloutBlock') {
            defaultProps = {
              quote: 'A natural dye is not a static color; it is a geographic signature of soil, water, and human hands.',
              author: 'Dr. E. Archer',
            };
          } else {
            defaultProps = {
              heading: 'Receive Field Notes',
              subheading: 'Postal dispatches covering new dye fermentations.',
              buttonText: 'Subscribe',
            };
          }

          const newBlock: EasyblocksBlock = {
            id: `blk-${Date.now()}`,
            type,
            props: defaultProps,
          };

          if (insertIndex >= 0 && insertIndex <= activeBlocks.length) {
            activeBlocks.splice(insertIndex, 0, newBlock);
          } else {
            activeBlocks.push(newBlock);
          }

          selectedBlockId = newBlock.id;
          document.getElementById('add-section-modal')?.classList.add('hidden');
          autoSaveLocal();
          renderCanvas();
          populateInspector();
        });
      });

      // Viewport switcher
      document.querySelectorAll('.vp-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.vp-btn').forEach((b) => b.classList.remove('bg-white', 'shadow-sm', 'text-black'));
          btn.classList.add('bg-white', 'shadow-sm', 'text-black');

          const vp = btn.getAttribute('data-vp') || '1024';
          const frame = document.getElementById('viewport-frame');
          if (frame) {
            frame.style.width = vp === '100%' ? '100%' : `${vp}px`;
          }
        });
      });

      // Edit mode toggle
      document.getElementById('edit-mode-toggle')?.addEventListener('change', (e) => {
        editMode = (e.target as HTMLInputElement).checked;
        const inspector = document.getElementById('easyblocks-inspector');
        if (inspector) {
          inspector.style.display = editMode ? 'flex' : 'none';
        }
        renderCanvas();
      });

      // Page select dropdown
      document.getElementById('page-select')?.addEventListener('change', (e) => {
        const slug = (e.target as HTMLSelectElement).value;
        loadPage(slug);
      });

      // Undo / Redo
      document.getElementById('undo-btn')?.addEventListener('click', () => {
        if (historyIndex > 0) {
          historyIndex--;
          activeBlocks = JSON.parse(historyStack[historyIndex]);
          renderCanvas();
          populateInspector();
        }
      });
      document.getElementById('redo-btn')?.addEventListener('click', () => {
        if (historyIndex < historyStack.length - 1) {
          historyIndex++;
          activeBlocks = JSON.parse(historyStack[historyIndex]);
          renderCanvas();
          populateInspector();
        }
      });

      // Toast notification
      function showToast(msg: string) {
        const toast = document.getElementById('toast-pill');
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3500);
      }

      // Save Draft / Publish
      async function handleSave(isDraft: boolean) {
        const landingDoc = {
          title: `Page: ${currentPageSlug}`,
          slug: currentPageSlug,
          description: `Custom page for ${currentPageSlug}`,
          draft: isDraft,
          updatedAt: new Date().toISOString(),
          blocks: activeBlocks,
        };

        // 1. Save local
        localStorage.setItem(`easyblocks_landing_${currentPageSlug}`, JSON.stringify(landingDoc));

        // 2. Commit to GitHub
        const config = getGitHubConfig();
        if (config && config.token && config.owner && config.repo) {
          try {
            await commitLandingPageToGitHub(config, currentPageSlug, landingDoc);
            showToast(
              isDraft
                ? 'Draft saved to Git with [skip ci] (Cloudflare rebuild skipped)!'
                : 'Published to Git! Cloudflare Pages rebuild triggered.'
            );
          } catch (err: any) {
            showToast(`GitHub Error: ${err.message}`);
          }
        } else {
          showToast('Changes saved locally in browser! Connect GitHub to commit.');
        }
      }

      document.getElementById('save-draft-btn')?.addEventListener('click', () => handleSave(true));
      document.getElementById('publish-btn')?.addEventListener('click', () => handleSave(false));

      // Check URL query param ?page=...
      const urlParams = new URLSearchParams(window.location.search);
      const queryPage = urlParams.get('page') || urlParams.get('slug') || 'home';

      // Initialize
      attachInspectorListeners();
      loadPage(queryPage);
    </script>
  </body>
</html>
