---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-parchment-deep border-t border-parchment-border mt-20 pt-16 pb-12 text-indigo-deep">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-parchment-border/80">
      
      <!-- Col 1: Identity & Voice -->
      <div class="md:col-span-2 space-y-4">
        <h3 class="font-heading text-2xl text-indigo-deep tracking-wide">
          Geographies of Textiles & Natural Dyes
        </h3>
        <p class="font-body text-sm sm:text-base text-indigo-deep/90 max-w-md leading-relaxed">
          An ongoing digital archive at the intersection of historical chemistry, botanical field ecology, and textile craftsmanship. Edited and written by Dr. E. Archer, PhD researcher & natural dyer.
        </p>
        <div class="font-mono text-xs text-sage-botanical uppercase tracking-widest pt-2">
          <span>COORDINATES: 25°12' N, 68°51' E &bull; ELEVATION: 42M</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-widest text-sage-botanical font-bold border-b border-parchment-border pb-1">
          Field Sections
        </h4>
        <ul class="space-y-2 font-mono text-xs uppercase tracking-wider">
          <li><a href="/" class="hover:text-madder-red transition-colors">&rarr; Frontispiece (Home)</a></li>
          <li><a href="/archives" class="hover:text-madder-red transition-colors">&rarr; Field Log Archives</a></li>
          <li><a href="/materials" class="hover:text-madder-red transition-colors">&rarr; Material & Pigment Atlas</a></li>
          <li><a href="/about" class="hover:text-madder-red transition-colors">&rarr; The Researcher & Artist</a></li>
          <li><a href="/admin" class="hover:text-madder-red transition-colors">&rarr; Writer Studio (Admin)</a></li>
        </ul>
      </div>

      <!-- Col 3: Research Focus -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-widest text-sage-botanical font-bold border-b border-parchment-border pb-1">
          Color Taxonomies
        </h4>
        <ul class="space-y-2 font-mono text-xs tracking-wider">
          <li class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-indigo-deep"></span>
            <span>Indigofera Tinctoria (Blue)</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-madder-red"></span>
            <span>Rubia Tinctorum (Red)</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-weld-ochre"></span>
            <span>Reseda Luteola (Yellow)</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-sage-botanical"></span>
            <span>Salvia & Quercus (Sage)</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom credits and citation -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs font-mono text-sage-botanical gap-4">
      <div>
        &copy; {currentYear} Geographies of Textiles & Natural Dyes &bull; All field notes, chemical sketches & imagery.
      </div>
      <div class="flex items-center gap-4">
        <span>Astro + Cloudflare Pages</span>
        <span>&bull;</span>
        <a href="/admin" class="hover:underline">Admin Portal</a>
      </div>
    </div>
  </div>
</footer>
