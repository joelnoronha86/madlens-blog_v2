---
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'HOME', href: '/' },
  { name: 'ARCHIVES', href: '/archives' },
  { name: 'MATERIAL MAP', href: '/materials' },
  { name: 'ABOUT', href: '/about' },
];
---

<header class="w-full bg-parchment-base border-b border-parchment-border sticky top-0 z-40 backdrop-blur-md bg-opacity-95 transition-all">
  <!-- Top decorative rule -->
  <div class="h-0.5 bg-gradient-to-r from-indigo-deep via-madder-red to-weld-ochre opacity-60"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 sm:h-24">
      
      <!-- Brand Title -->
      <div class="flex flex-col">
        <a href="/" class="group">
          <span class="font-heading text-2xl sm:text-3xl md:text-4xl text-indigo-deep tracking-wide group-hover:text-madder-red transition-colors duration-200">
            Geographies of Natural Dyes & Textiles
          </span>
          <span class="hidden sm:block font-heading italic text-xs sm:text-sm text-sage-botanical tracking-widest mt-0.5">
            Where Chemistry Meets Living Color & Historical Fiber
          </span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-6 lg:space-x-8">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`font-mono text-xs lg:text-sm tracking-widest uppercase transition-colors relative py-1 ${
                isActive
                  ? 'text-madder-red font-bold'
                  : 'text-indigo-deep hover:text-madder-red'
              }`}
            >
              {item.name}
              {isActive && (
                <span class="absolute bottom-0 left-0 w-full h-0.5 bg-madder-red"></span>
              )}
            </a>
          );
        })}

        <!-- Admin / Studio Entry Pill -->
        <a
          href="/admin"
          class="font-mono text-xs tracking-wider uppercase px-3 py-1.5 rounded border border-indigo-deep/30 bg-parchment-deep text-indigo-deep hover:bg-indigo-deep hover:text-parchment-light transition-all flex items-center gap-1.5 shadow-sm"
          title="Access Author CMS / Tiptap Studio"
        >
          <svg class="w-3.5 h-3.5 text-madder-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span>STUDIO</span>
        </a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-3 md:hidden">
        <a
          href="/admin"
          class="font-mono text-xs px-2.5 py-1 rounded border border-indigo-deep/30 bg-parchment-deep text-indigo-deep"
        >
          STUDIO
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 text-indigo-deep hover:text-madder-red focus:outline-none"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
            <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-parchment-border bg-parchment-light px-4 pt-3 pb-6 space-y-3">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block font-mono text-sm tracking-wider uppercase text-indigo-deep hover:text-madder-red py-1.5 border-b border-parchment-border/40"
      >
        {item.name}
      </a>
    ))}
    <div class="pt-2">
      <a
        href="/admin"
        class="block text-center font-mono text-xs uppercase px-4 py-2 rounded bg-indigo-deep text-parchment-light"
      >
        Writer Admin Studio
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
