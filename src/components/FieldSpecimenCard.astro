---
interface SwatchItem {
  name: string;
  binomial?: string;
  color: string;
  texture?: string;
}

interface ChemicalStructure {
  name: string;
  formula: string;
  description?: string;
}

interface SpecimenData {
  name: string;
  commonName?: string;
  logNo?: string;
  origin?: string;
  coordinates?: string;
  process?: string;
  chemicalStructure?: ChemicalStructure;
}

interface Props {
  specimen?: SpecimenData;
  swatches?: SwatchItem[];
}

const { specimen, swatches = [] } = Astro.props;
---

<aside class="space-y-6">
  <!-- Specimen Field Box -->
  <div class="border border-parchment-border bg-parchment-light/80 p-5 rounded-sm relative shadow-sm">
    <div class="flex items-center justify-between border-b border-parchment-border pb-2.5 mb-4">
      <span class="font-mono text-xs uppercase tracking-widest text-sage-botanical font-bold">
        FIELD LOGS & DATA
      </span>
      <span class="font-mono text-[11px] text-ink-muted">
        ARCHIVE #{specimen?.logNo ? specimen.logNo.replace('#', '') : '2026-N'}
      </span>
    </div>

    {specimen && (
      <dl class="space-y-3 font-mono text-xs text-indigo-deep">
        {specimen.name && (
          <div>
            <dt class="text-[11px] text-sage-botanical uppercase tracking-wider">SPECIMEN:</dt>
            <dd class="font-bold text-sm tracking-wide text-indigo-dark italic">{specimen.name}</dd>
          </div>
        )}

        {specimen.logNo && (
          <div>
            <dt class="text-[11px] text-sage-botanical uppercase tracking-wider">LOG NO:</dt>
            <dd class="text-xs">{specimen.logNo}</dd>
          </div>
        )}

        {specimen.origin && (
          <div>
            <dt class="text-[11px] text-sage-botanical uppercase tracking-wider">ORIGIN:</dt>
            <dd class="text-xs">{specimen.origin}</dd>
          </div>
        )}

        {specimen.coordinates && (
          <div>
            <dt class="text-[11px] text-sage-botanical uppercase tracking-wider">COORDINATES:</dt>
            <dd class="text-xs text-madder-red font-semibold">{specimen.coordinates}</dd>
          </div>
        )}

        {specimen.process && (
          <div>
            <dt class="text-[11px] text-sage-botanical uppercase tracking-wider">PROCESS:</dt>
            <dd class="text-xs leading-relaxed">{specimen.process}</dd>
          </div>
        )}
      </dl>
    )}

    <!-- Chemical Structure Box if available -->
    {specimen?.chemicalStructure && (
      <div class="mt-5 pt-4 border-t border-parchment-border">
        <div class="font-mono text-[11px] uppercase tracking-wider text-sage-botanical mb-2">
          CHEMICAL STRUCTURE // {specimen.chemicalStructure.name} ({specimen.chemicalStructure.formula})
        </div>
        
        <!-- Molecular structural representation -->
        <div class="bg-parchment-deep/60 p-3 rounded border border-parchment-border/60 flex flex-col items-center justify-center">
          <svg class="w-full max-w-[220px] h-28 text-indigo-deep" viewBox="0 0 240 120" fill="none" stroke="currentColor" stroke-width="1.6">
            <!-- Left benzene ring -->
            <polygon points="40,30 65,15 90,30 90,60 65,75 40,60" />
            <line x1="45" y1="34" x2="63" y2="23" stroke-width="1.2" />
            <line x1="85" y1="34" x2="85" y2="56" stroke-width="1.2" />
            <line x1="45" y1="56" x2="63" y2="67" stroke-width="1.2" />
            
            <!-- Central connecting 5-member rings with C=O and N-H -->
            <line x1="90" y1="30" x2="115" y2="20" />
            <line x1="115" y1="20" x2="125" y2="45" />
            <line x1="125" y1="45" x2="90" y2="60" />
            
            <!-- Carbonyl O -->
            <line x1="115" y1="20" x2="115" y2="5" stroke-width="2" />
            <text x="111" y="2" font-family="'Courier Prime', monospace" font-size="10" fill="currentColor">O</text>

            <!-- Center double bond -->
            <line x1="125" y1="45" x2="135" y2="45" stroke-width="3" />
            <line x1="125" y1="48" x2="135" y2="48" stroke-width="1.2" />

            <!-- Right 5-member ring -->
            <line x1="135" y1="45" x2="145" y2="70" />
            <line x1="145" y1="70" x2="170" y2="60" />
            <line x1="170" y1="60" x2="170" y2="30" />
            <line x1="170" y1="30" x2="135" y2="45" />

            <!-- Nitrogen N -->
            <text x="138" y="85" font-family="'Courier Prime', monospace" font-size="10" fill="currentColor">N-H</text>

            <!-- Right benzene ring -->
            <polygon points="170,30 195,15 220,30 220,60 195,75 170,60" />
            <line x1="175" y1="34" x2="193" y2="23" stroke-width="1.2" />
            <line x1="215" y1="34" x2="215" y2="56" stroke-width="1.2" />
            <line x1="175" y1="56" x2="193" y2="67" stroke-width="1.2" />
          </svg>
          <span class="font-mono text-[10px] text-sage-botanical text-center mt-1">
            {specimen.chemicalStructure.description || 'Coordination chromophore bond map'}
          </span>
        </div>
      </div>
    )}
  </div>

  <!-- Swatches Box -->
  {swatches.length > 0 && (
    <div class="border border-parchment-border bg-parchment-light/80 p-5 rounded-sm shadow-sm">
      <div class="font-mono text-xs uppercase tracking-widest text-sage-botanical font-bold border-b border-parchment-border pb-2.5 mb-4">
        AUTHENTIC TEXTILE SWATCHES
      </div>
      <div class="grid grid-cols-2 gap-4">
        {swatches.map((swatch) => (
          <div class="flex flex-col items-center text-center group">
            <!-- Swatch box with pinked frayed edges -->
            <div
              class="w-20 h-20 sm:w-24 sm:h-24 swatch-pinked shadow-md transition-transform duration-200 group-hover:scale-105"
              style={`background-color: ${swatch.color};`}
              title={`${swatch.name} (${swatch.color})`}
            >
              <!-- Texture weave overlay -->
              <div class="w-full h-full opacity-20 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:4px_4px]"></div>
            </div>
            <div class="mt-2.5 font-mono text-[11px] font-bold text-indigo-deep uppercase tracking-wider">
              {swatch.name}
            </div>
            {swatch.binomial && (
              <div class="font-heading italic text-xs text-sage-botanical">
                {swatch.binomial}
              </div>
            )}
            <div class="font-mono text-[10px] text-ink-muted">
              {swatch.color.toUpperCase()} &bull; {swatch.texture || 'linen'}
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Botanical Compass Card -->
  <div class="border border-parchment-border/80 bg-parchment-deep/40 p-4 rounded-sm flex items-center gap-3">
    <svg class="w-8 h-8 text-sage-botanical shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
      <circle cx="12" cy="12" r="10" />
      <polygon points="12,2 15,10 12,12 9,10" fill="currentColor" opacity="0.4" />
      <polygon points="12,22 15,14 12,12 9,14" fill="currentColor" opacity="0.2" />
      <polygon points="2,12 10,9 12,12 10,15" fill="currentColor" opacity="0.2" />
      <polygon points="22,12 14,9 12,12 14,15" fill="currentColor" opacity="0.4" />
    </svg>
    <div class="font-mono text-[11px] text-indigo-deep leading-tight">
      <span class="font-bold uppercase tracking-wider block text-sage-botanical">GEOGRAPHIC RECORD:</span>
      Catalogued in the Natural Dye Herbarium & Fiber Laboratory.
    </div>
  </div>
</aside>
