---
import { marked } from 'marked';

interface Props {
  content?: string;
}

const { content = 'Enter freeform markdown here.' } = Astro.props;
const html = await marked.parse(content);
---

<section class="py-12 bg-parchment-base border-b border-parchment-border">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="prose prose-lg max-w-none text-indigo-deep font-body leading-relaxed bg-parchment-light/80 p-8 rounded-sm border border-parchment-border shadow-sm" set:html={html} />
  </div>
</section>
