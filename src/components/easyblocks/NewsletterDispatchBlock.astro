---
interface Props {
  heading?: string;
  subheading?: string;
  buttonText?: string;
}

const {
  heading = 'Receive Field Notes & Dye Recipes',
  subheading = 'Occasional postal dispatches covering new fermentation experiments and botanical specimen findings.',
  buttonText = 'Subscribe to Dispatches',
} = Astro.props;
---

<section class="py-16 bg-parchment-base border-b border-parchment-border">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
    <div class="font-mono text-xs uppercase tracking-widest text-sage-botanical font-bold">
      ✦ DISPATCHES FROM THE FIELD STATION ✦
    </div>
    <h2 class="font-heading text-3xl sm:text-4xl text-indigo-deep">
      {heading}
    </h2>
    <p class="font-body text-base text-indigo-deep/80 max-w-lg mx-auto">
      {subheading}
    </p>

    <form id="newsletter-dispatch-form" class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-4 max-w-md mx-auto">
      <input
        type="email"
        required
        placeholder="researcher@fieldarchive.org"
        class="w-full px-4 py-2.5 rounded border border-parchment-border bg-parchment-light font-mono text-xs text-indigo-deep focus:outline-none focus:border-indigo-deep"
      />
      <button
        type="submit"
        class="w-full sm:w-auto px-6 py-2.5 rounded bg-indigo-deep text-parchment-light font-mono text-xs uppercase tracking-widest font-bold hover:bg-madder-red transition-colors whitespace-nowrap"
      >
        {buttonText}
      </button>
    </form>
  </div>
</section>

<script>
  document.getElementById('newsletter-dispatch-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Thank you for requesting the symposium syllabus & updates!');
  });
</script>
